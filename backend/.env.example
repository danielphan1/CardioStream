# Backend environment inventory (DEPL-01, SEC-02, SEC-03)
#
# This file is a DOCUMENTED TEMPLATE ONLY. It contains placeholder / non-secret
# values so a redeploy is reproducible. Copy it to `backend/.env` for local dev
# (that .env is gitignored — SEC-02). In production, set the real values ONLY in
# the Railway service variables dashboard, NEVER in git and NEVER in the frontend.
#
# Railway note: DATABASE_URL is injected automatically once a PostgreSQL service
# is provisioned; you do NOT set it by hand. The app + Alembic both read the
# normalized value via get_settings().database_url (config.py normalizes a bare
# postgresql:// to postgresql+psycopg:// — RESEARCH Pitfall 2).

# --- DATABASE_URL -----------------------------------------------------------
# Local dev: SQLite (default in config.py if unset). Prod: injected by Railway
# as postgresql://... and normalized to postgresql+psycopg:// at boot.
# Keep Postgres on Railway PRIVATE networking (postgres.railway.internal) — do
# NOT add a public TCP proxy (SEC-03, threat T-05-16).
DATABASE_URL=sqlite:///./dev.db

# --- ANTHROPIC_API_KEY ------------------------------------------------------
# Claude API key for the /agent endpoint (SEC-02). Backend-only; never exposed
# to the frontend. App boots keyless (agent degrades to "unavailable") if unset.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- SITE_PASSWORD ----------------------------------------------------------
# Shared-password gate (SEC-01). Set the chosen shared password ONLY in Railway
# variables — never in git or the frontend.
SITE_PASSWORD=choose-a-shared-password

# --- TOKEN_SECRET -----------------------------------------------------------
# itsdangerous signing secret for the Bearer token (SEC-01, threat T-05-18).
# Generate a strong value:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# The "dev-insecure-secret" default in config.py is for local tests ONLY; prod
# MUST override this via Railway variables. Never ship it to the client.
TOKEN_SECRET=generate-with-secrets-token_urlsafe-32

# --- CORS_ORIGINS -----------------------------------------------------------
# The exact Vercel production origin(s), as a JSON ARRAY (RESEARCH Pitfall 3):
# pydantic-settings JSON-parses this list[str] field from the env. A bare string
# (CORS_ORIGINS=https://<app>.vercel.app) raises a JSON-decode SettingsError at
# boot. No wildcard, no allow_credentials (locked CORS model, threat T-05-17).
CORS_ORIGINS=["https://<app>.vercel.app"]

# --- Frontend (set in Vercel, NOT here) -------------------------------------
# The frontend needs VITE_API_URL set in the Vercel project (root dir = frontend).
# It is baked into the build at build time, so changing it requires a rebuild.
#   VITE_API_URL=https://<app>.railway.app
